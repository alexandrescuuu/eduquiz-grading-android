<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#09090B">

    <!-- Camera preview - ocupa tot ecranul -->
    <androidx.camera.view.PreviewView
        android:id="@+id/camera_preview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_controls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Overlay ghidaj (dreptunghi transparent) -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#33000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_controls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Header cu mod scanare -->
    <LinearLayout
        android:id="@+id/header_scan"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#CC09090B"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_scan_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Scanare"
            android:textColor="#A78BFA"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAllCaps="true" />

        <TextView
            android:id="@+id/tv_instruction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fotografiaza raspunsul scris."
            android:textColor="#FAFAFA"
            android:textSize="13sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Cadru ghidaj pentru foaie -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/transparent"

        app:layout_constraintTop_toBottomOf="@id/header_scan"
        app:layout_constraintBottom_toTopOf="@id/bottom_controls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.85"
        app:layout_constraintHeight_percent="0.6" />

    <!-- Processing overlay -->
    <LinearLayout
        android:id="@+id/layout_processing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#EE09090B"
        android:padding="24dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_controls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminateTint="#A78BFA" />

        <TextView
            android:id="@+id/tv_processing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Se analizeaza imaginea..."
            android:textColor="#FAFAFA"
            android:textSize="14sp"
            android:layout_marginTop="12dp"
            android:gravity="center" />
    </LinearLayout>

    <!-- Bottom controls -->
    <LinearLayout
        android:id="@+id/bottom_controls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#CC09090B"
        android:padding="20dp"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Sfaturi OCR -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Scrie clar • Lumina buna • Fara umbre"
            android:textColor="#71717A"
            android:textSize="11sp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btn_capture"
            android:layout_width="180dp"
            android:layout_height="56dp"
            android:text="Fotografiaza"
            android:textColor="#09090B"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#A78BFA" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
