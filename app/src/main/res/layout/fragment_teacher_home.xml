<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#09090B"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Teacher dashboard"
                    android:textColor="#71717A"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_teacher_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Loading..."
                    android:textColor="#FAFAFA"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_avatar"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_avatar_green"
                android:gravity="center"
                android:text="?"
                android:textColor="#34D399"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Stats Grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tests created"
                    android:textColor="#71717A"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tv_tests_corrected"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FAFAFA"
                    android:textSize="26sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Class average"
                    android:textColor="#71717A"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tv_class_average"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#A78BFA"
                    android:textSize="26sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total students"
                    android:textColor="#71717A"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tv_active_students"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FAFAFA"
                    android:textSize="26sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Submissions"
                    android:textColor="#71717A"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tv_pending_scans"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FBBF24"
                    android:textSize="26sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Action Buttons -->
        <Button
            android:id="@+id/btn_create_test"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Create new test"
            android:textColor="#09090B"
            android:textStyle="bold"
            android:textSize="14sp"
            android:backgroundTint="#A78BFA"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btn_view_tests"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="View my tests"
            android:textColor="#A78BFA"
            android:textSize="14sp"
            android:backgroundTint="#18181B"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btn_scan_full"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Scan full page"
            android:textColor="#A78BFA"
            android:textSize="14sp"
            android:backgroundTint="#18181B"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btn_scan_omr"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Scan OMR sheet"
            android:textColor="#A78BFA"
            android:textSize="14sp"
            android:backgroundTint="#18181B"
            android:layout_marginBottom="20dp" />

        <!-- Recent Tests -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recent tests"
            android:textColor="#FAFAFA"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_recent_tests"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>
</ScrollView>
