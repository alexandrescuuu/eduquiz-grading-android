<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="16dp"
    android:background="@drawable/bg_card"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true">

    <!-- Accent bar stanga -->
    <View
        android:id="@+id/accent_bar"
        android:layout_width="3dp"
        android:layout_height="52dp"
        android:background="#A78BFA"
        android:layout_marginEnd="14dp"/>

    <!-- Continut principal -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Badges row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/tv_test_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="mixed"
                android:textColor="#A78BFA"
                android:textSize="10sp"
                android:background="@drawable/bg_badge_purple"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:layout_marginEnd="6dp"/>

            <TextView
                android:id="@+id/tv_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="active"
                android:textColor="#34D399"
                android:textSize="10sp"
                android:background="@drawable/bg_badge_green"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"/>
        </LinearLayout>

        <!-- Nume test -->
        <TextView
            android:id="@+id/tv_test_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Test Name"
            android:textColor="#FAFAFA"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <!-- Info row: intrebari / puncte / studenti -->
        <TextView
            android:id="@+id/tv_test_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3 questions / 30 pts"
            android:textColor="#52525B"
            android:textSize="12sp"/>

    </LinearLayout>

    <!-- Dreapta: scor medie sau sageata -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginStart="8dp">

        <TextView
            android:id="@+id/tv_avg_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#34D399"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="#52525B"
            android:textSize="24sp"
            android:gravity="center"/>
    </LinearLayout>

</LinearLayout>
