<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#18181B"
    android:padding="16dp"
    android:layout_marginBottom="12dp">

    <!-- Question Number & Points -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tv_question_number"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Question 1"
            android:textColor="#A78BFA"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tv_score_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="8.0/10"
            android:textColor="#FAFAFA"
            android:textSize="16sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <!-- Question Text -->
    <TextView
        android:id="@+id/tv_question_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="What is the capital of France?"
        android:textColor="#FAFAFA"
        android:textSize="16sp"
        android:layout_marginBottom="12dp"/>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#27272A"
        android:layout_marginBottom="12dp"/>

    <!-- Your Answer -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your Answer:"
        android:textColor="#71717A"
        android:textSize="12sp"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:id="@+id/tv_student_answer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Paris"
        android:textColor="#A78BFA"
        android:textSize="15sp"
        android:layout_marginBottom="12dp"/>

    <!-- Correct Answer -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Correct Answer:"
        android:textColor="#71717A"
        android:textSize="12sp"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:id="@+id/tv_correct_answer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Paris"
        android:textColor="#34D399"
        android:textSize="15sp"
        android:layout_marginBottom="12dp"/>

    <!-- AI Feedback -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AI Feedback:"
        android:textColor="#71717A"
        android:textSize="12sp"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:id="@+id/tv_feedback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Răspuns corect și complet."
        android:textColor="#E5E5E5"
        android:textSize="14sp"
        android:lineSpacingExtra="4dp"/>

</LinearLayout>