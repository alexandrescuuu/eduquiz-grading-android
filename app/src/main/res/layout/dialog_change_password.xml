<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#18181B">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Parola curenta"
        android:textColor="#71717A"
        android:textSize="12sp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/et_current_password"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Introdu parola curenta"
        android:inputType="textPassword"
        android:textColor="#FAFAFA"
        android:textColorHint="#3F3F46"
        android:background="#27272A"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Parola noua"
        android:textColor="#71717A"
        android:textSize="12sp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/et_new_password"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Minim 4 caractere"
        android:inputType="textPassword"
        android:textColor="#FAFAFA"
        android:textColorHint="#3F3F46"
        android:background="#27272A"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Confirma parola noua"
        android:textColor="#71717A"
        android:textSize="12sp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/et_confirm_password"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Repeta parola noua"
        android:inputType="textPassword"
        android:textColor="#FAFAFA"
        android:textColorHint="#3F3F46"
        android:background="#27272A"
        android:paddingHorizontal="12dp" />

</LinearLayout>
